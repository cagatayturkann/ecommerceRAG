# Copy to .env and fill in ANTHROPIC_API_KEY. Never commit .env.

PORT=3000
NODE_ENV=development

# Comma-separated origins allowed to call /api when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB stores conversation history.
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce-rag

# Weaviate from docker-compose.yml (REST on 8090, gRPC on 50061).
# For Weaviate Cloud, set the cluster URL and WEAVIATE_API_KEY instead.
WEAVIATE_URL=http://127.0.0.1:8090
WEAVIATE_GRPC_PORT=50061
WEAVIATE_API_KEY=

# Claude API key (https://platform.claude.com). Models can be overridden.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_REWRITE_MODEL=claude-haiku-5-5

# Chat rate limit per client IP.
CHAT_RATE_LIMIT_PER_MINUTE=20
